# ===== PLAYORA BACKEND - CONTOH KONFIGURASI =====
# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya.
# JANGAN commit berkas `.env` yang berisi nilai sebenarnya.

# Lingkungan: development | test | production
# `production` mengaktifkan flag Secure pada cookie, sehingga WAJIB dilayani via HTTPS.
NODE_ENV=development

# Port HTTP API
PORT=5000

# Koneksi database (MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="mysql://root@localhost:3306/playora_db"

# Rahasia penandatanganan JWT. WAJIB diganti dengan nilai acak >= 32 karakter di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET="ganti-dengan-nilai-acak-minimal-32-karakter"
JWT_EXPIRES_IN="7d"

# Rahasia tanda tangan token CSRF. HARUS berbeda dari JWT_SECRET.
CSRF_SECRET="ganti-juga-dengan-nilai-acak-berbeda-minimal-32-karakter"

# Origin frontend yang diizinkan (CORS + pemeriksaan Origin CSRF). Pisahkan dengan koma.
CORS_ORIGIN="http://localhost:5173"

# Biaya hashing bcrypt (8-15, disarankan 10-12)
BCRYPT_SALT_ROUNDS=10

# Rate limit (default: jendela 15 menit)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=30
RATE_LIMIT_REGISTER_MAX=5

# Cloudinary (dipakai pada tahap modul upload)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
